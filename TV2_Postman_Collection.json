	"item": [
		{
			"name": "01. Auth Flow",
			"item": [
				{
					"name": "1.1 Đăng ký User mới (POST /api/v1/auth/register)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Tạo email ngẫu nhiên theo timestamp để test lặp lại không bị trùng email",
									"var timestamp = Date.now();",
									"var randomEmail = 'e2e_user_' + timestamp + '@ecommerce.com';",
									"var defaultPassword = 'Password123!';",
									"var fullName = 'Nguyen Van E2E ' + timestamp;",
									"",
									"pm.environment.set('test_user_email', randomEmail);",
									"pm.collectionVariables.set('test_user_email', randomEmail);",
									"pm.environment.set('test_user_password', defaultPassword);",
									"pm.collectionVariables.set('test_user_password', defaultPassword);",
									"pm.environment.set('test_user_name', fullName);",
									"pm.collectionVariables.set('test_user_name', fullName);",
									"console.log('Generating test account: ' + randomEmail);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('1.1 Đăng ký: Trả về HTTP 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('1.1 Đăng ký: Cấu trúc response hợp lệ', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    if (jsonData.data && jsonData.data.userId) {",
									"        pm.environment.set('userId', jsonData.data.userId);",
									"        pm.collectionVariables.set('userId', jsonData.data.userId);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_user_email}}\",\n    \"password\": \"{{test_user_password}}\",\n    \"fullName\": \"{{test_user_name}}\",\n    \"phone\": \"0987654321\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Tạo user mới qua API Gateway. Mong đợi HTTP 201 Created."
					},
					"response": []
				},
				{
					"name": "1.2 Đăng nhập & Lấy JWT Token (POST /api/v1/auth/login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('1.2 Đăng nhập: Trả về HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('1.2 Đăng nhập: Trích xuất accessToken và lưu vào {{jwt_token}}', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    var token = (jsonData.data && jsonData.data.accessToken) ? jsonData.data.accessToken : jsonData.accessToken;",
									"    pm.expect(token).to.be.a('string').and.not.empty;",
									"    ",
									"    pm.environment.set('jwt_token', token);",
									"    pm.collectionVariables.set('jwt_token', token);",
									"    console.log('jwt_token extracted: ' + token.substring(0, 20) + '...');",
									"    ",
									"    var userId = (jsonData.data && jsonData.data.userId) ? jsonData.data.userId : jsonData.userId;",
									"    if (userId) {",
									"        pm.environment.set('userId', userId);",
									"        pm.collectionVariables.set('userId', userId);",
									"        console.log('userId extracted: ' + userId);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_user_email}}\",\n    \"password\": \"{{test_user_password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập với user vừa tạo. Lưu accessToken vào biến {{jwt_token}}."
					},
					"response": []
				}
			],
			"description": "Kịch bản xác thực tài khoản qua API Gateway."
		},
		{
			"name": "02. Security & Gateway Flow",
			"item": [
				{
					"name": "2.1 Truy cập Order Không Token (GET /api/v1/orders/1) - Expect 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('2.1 Security Gateway: Expect HTTP 401 Unauthorized khi không truyền Token', function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test('2.1 Security Gateway: Xác nhận AuthenticationFilter chặn thành công', function () {",
									"    pm.expect(pm.response.code).to.equal(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"1"
							]
						},
						"description": "Gọi API Order không có Authorization Header. AuthenticationFilter tại Gateway phải chặn và trả về HTTP 401 Unauthorized."
					},
					"response": []
				},
				{
					"name": "2.2 Truy cập Order Có Token (GET /api/v1/orders/1) - Expect Pass Filter",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('2.2 Security Gateway: Có Token hợp lệ, Gateway cho phép đi qua (Không bị 401)', function () {",
									"    pm.expect(pm.response.code).to.not.equal(401);",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"1"
							]
						},
						"description": "Gọi API Order kèm Bearer Token. Xác nhận AuthenticationFilter xác thực thành công và định tuyến xuống Order Service."
					},
					"response": []
				}
			],
			"description": "Kiểm tra bảo mật tập trung tại API Gateway qua AuthenticationFilter."
		},
		{
			"name": "03. Product Flow",
			"item": [
				{
					"name": "3.1 Tạo sản phẩm mới (POST /api/v1/products)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('3.1 Product Flow: Tạo sản phẩm trả về HTTP 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('3.1 Product Flow: Lưu productId, xác nhận giá 10 triệu và tồn kho 10', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    var product = jsonData.data || jsonData;",
									"    var prodId = product.id;",
									"    pm.expect(prodId).to.not.be.undefined;",
									"    ",
									"    pm.environment.set('productId', prodId);",
									"    pm.collectionVariables.set('productId', prodId);",
									"    console.log('Created test product ID: ' + prodId);",
									"    ",
									"    pm.expect(Number(product.price)).to.equal(10000000);",
									"    pm.expect(product.stockQuantity).to.equal(10);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"E2E Test Laptop Ultra 15\",\n    \"description\": \"Sản phẩm phục vụ kiểm thử End-to-End tự động\",\n    \"price\": 10000000,\n    \"stockQuantity\": 10,\n    \"category\": \"Electronics\",\n    \"imageUrl\": \"https://images.unsplash.com/photo-1496181133206-80ce9b88a853\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"products"
							]
						},
						"description": "Tạo 1 sản phẩm mới với giá 10,000,000 VND và số lượng tồn kho là 10. Trích xuất id lưu vào biến {{productId}}."
					},
					"response": []
				},
				{
					"name": "3.2 Kiểm tra chi tiết & Cache Redis (GET /api/v1/products/{{productId}})",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('3.2 Product Flow: Trả về HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('3.2 Product Flow: Dữ liệu sản phẩm trên Redis Cache chính xác', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    var product = jsonData.data || jsonData;",
									"    pm.expect(product.id.toString()).to.equal(pm.collectionVariables.get('productId').toString());",
									"    pm.expect(Number(product.price)).to.equal(10000000);",
									"    pm.expect(product.stockQuantity).to.equal(10);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/{{productId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"products",
								"{{productId}}"
							]
						},
						"description": "Lấy chi tiết sản phẩm {{productId}}. Xác nhận thông tin sản phẩm đã sẵn sàng và được cache trên Redis."
					},
					"response": []
				}
			],
			"description": "Quản lý sản phẩm và xác thực cơ chế Redis Cache."
		},
		{
			"name": "04. Saga Pattern - Happy Path",
			"item": [
				{
					"name": "4.1 Đặt hàng thành công 1 SP (POST /api/v1/orders/checkout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('4.1 Happy Path Checkout: Trả về HTTP 200 hoặc 201', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"pm.test('4.1 Happy Path Checkout: Trích xuất success_order_id', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    var order = jsonData.data || jsonData;",
									"    var orderId = order.id;",
									"    pm.expect(orderId).to.not.be.undefined;",
									"    ",
									"    pm.environment.set('success_order_id', orderId);",
									"    pm.collectionVariables.set('success_order_id', orderId);",
									"    console.log('Placed order success ID: ' + orderId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": {{userId}},\n    \"receiverName\": \"Nguyen Van Thanh Toan\",\n    \"receiverPhone\": \"0987654321\",\n    \"shippingAddress\": \"123 Pham Van Dong, Cau Giay, Ha Noi\",\n    \"paymentMethod\": \"MOCK_ONLINE\",\n    \"items\": [\n        {\n            \"productId\": {{productId}},\n            \"productName\": \"E2E Test Laptop Ultra 15\",\n            \"quantity\": 1,\n            \"priceAtPurchase\": 10000000\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/checkout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"checkout"
							]
						},
						"description": "Mua 1 sản phẩm với tổng tiền 10,000,000 VND (< 50 triệu). Lưu orderId vào {{success_order_id}}."
					},
					"response": []
				},
				{
					"name": "4.2 Kiểm tra đơn hàng sau 2s - Status PAID (GET /api/v1/orders/{{success_order_id}})",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Chờ 2 giây để Payment Service và Kafka xử lý bất đồng bộ sự kiện thanh toán",
									"console.log('Chờ 2000ms để Kafka & Payment Service xử lý Saga hoàn tất...');",
									"var start = Date.now();",
									"while (Date.now() - start < 2000) {",
									"    // Chờ 2s đồng bộ tương thích cả Newman runner và Postman Desktop",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('4.2 Happy Path Verify: Trả về HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('4.2 Happy Path Verify: Order status == PAID (Payment Service & Kafka thành công)', function () {",
									"    var jsonData = pm.response.json();",
									"    var order = jsonData.data || jsonData;",
									"    pm.expect(order.status).to.equal('PAID');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/{{success_order_id}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"{{success_order_id}}"
							]
						},
						"description": "Gọi sau 2 giây delay. Trạng thái đơn hàng phải chuyển sang PAID."
					},
					"response": []
				},
				{
					"name": "4.3 Xác nhận tồn kho đã bị trừ còn 9 (GET /api/v1/products/{{productId}})",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('4.3 Happy Path Verify Stock: Trả về HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('4.3 Happy Path Verify Stock: Tồn kho đã trừ 1 còn 9 (10 - 1 = 9)', function () {",
									"    var jsonData = pm.response.json();",
									"    var product = jsonData.data || jsonData;",
									"    pm.expect(product.stockQuantity).to.equal(9);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/{{productId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"products",
								"{{productId}}"
							]
						},
						"description": "Kiểm tra kho sản phẩm sau khi đơn hàng thanh toán thành công. Tồn kho phải giảm từ 10 xuống 9."
					},
					"response": []
				}
			],
			"description": "Kịch bản Saga thành công: Trừ kho -> Tạo đơn PENDING -> Thanh toán thành công -> Đơn PAID."
		},
		{
			"name": "05. Saga Pattern - Rollback Flow",
			"item": [
				{
					"name": "5.1 Đặt hàng vượt hạn mức 6 SP (POST /api/v1/orders/checkout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
