# Base URL của Backend API Gateway:
# - Khi chạy trên trình duyệt (Vite Dev Server :5173 hoặc Docker Nginx :3000 / :80),
#   api.js tự động chuẩn hóa về relative path '/api/v1' qua Vite Proxy / Nginx Reverse Proxy.
# - Khi chạy Node.js test runner (npm test), sử dụng URL trực tiếp tới API Gateway:
VITE_API_URL=http://localhost:8080/api/v1
# Bật/tắt chế độ chỉ dùng Mock Authentication trên Frontend (true/false)
VITE_USE_MOCK_AUTH=false
