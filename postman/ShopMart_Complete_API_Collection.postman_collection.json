						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{user_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"success\": false,\n  \"note\": \"Nguoi dung tu choi xac thuc OTP\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payments/mock-pay/{{orderId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payments", "mock-pay", "{{orderId}}"]
						}
					}
				},
				{
					"name": "Get Payment Info by Order ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{user_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/payments/order/{{orderId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payments", "order", "{{orderId}}"]
						}
					}
				}
			]
		},
		{
			"name": "6. Admin Management",
			"item": [
				{
					"name": "Admin Create Product",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Samsung Galaxy S24 Ultra\",\n  \"description\": \"Flagship Android 2024\",\n  \"price\": 29990000,\n  \"stock\": 50,\n  \"categoryId\": 1,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1610945415295-d9bbf067e59c\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/products",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"]
						}
					}
				},
				{
					"name": "Admin Update Stock",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"stock\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/{{productId}}/stock",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "{{productId}}", "stock"]
						}
					}
				},
				{
					"name": "Admin List All Orders",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/orders?page=0&size=20&status=PENDING",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "orders"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "20" },
								{ "key": "status", "value": "PENDING" }
							]
						}
					}
				},
				{
					"name": "Admin Update Order Status (Approve / Transition)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"CONFIRMED\",\n  \"note\": \"Admin da duyet don hang hop le\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "orders", "{{orderId}}", "status"]
						}
					}
				}
			]
		},
