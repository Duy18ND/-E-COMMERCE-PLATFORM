    {
      "name": "06. Timeline History",
      "description": "Kiểm thử cấu trúc, tính đầy đủ và thứ tự thời gian của dữ liệu Timeline (ECOM-189 Nhóm C)",
      "item": [
        {
          "name": "TC-189-18: Kiểm tra thứ tự và dữ liệu Timeline của đơn hàng",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userAToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{testOrderId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{testOrderId}}", "history"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Timeline items are sorted ascending by createdAt', function () {",
                  "    var json = pm.response.json();",
                  "    var list = json.data;",
                  "    pm.expect(list).to.be.an('array');",
                  "    if (list.length >= 2) {",
                  "        for (var i = 0; i < list.length - 1; i++) {",
                  "            var timeA = new Date(list[i].createdAt).getTime();",
                  "            var timeB = new Date(list[i+1].createdAt).getTime();",
                  "            pm.expect(timeA).to.be.at.most(timeB);",
                  "        }",
                  "    }",
                  "});",
                  "pm.test('First event is ORDER_CREATED with status PENDING', function () {",
                  "    var json = pm.response.json();",
                  "    var list = json.data;",
                  "    if (list.length > 0) {",
                  "        pm.expect(list[0].status).to.eql('PENDING');",
                  "        pm.expect(list[0].action).to.eql('ORDER_CREATED');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
