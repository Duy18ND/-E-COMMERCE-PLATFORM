# ═══════════════════════════════════════════════════════════════
#  E-Commerce Platform — Backend & Docker Environment Template
#  Copy file này thành `.env` và thay đổi thông tin khi triển khai
# ═══════════════════════════════════════════════════════════════

# Spring Boot Active Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# MySQL 8.0 Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=product_db
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass

# Redis 7 Cache & Rate Limiter Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Apache Kafka & Kafka UI Configuration
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Eureka Discovery Server Configuration
EUREKA_USER=eureka
EUREKA_PASSWORD=eurekapassword
EUREKA_PORT=8761

# JWT Authentication Secret (Minimum 256-bit key)
JWT_SECRET=ecommerce-super-secret-key-change-in-production-must-be-256-bits

# Frontend & Nginx Reverse Proxy Ports
FRONTEND_PORT=5173
NGINX_PORT=80