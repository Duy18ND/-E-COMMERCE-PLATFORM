# ═══════════════════════════════════════════════════════════════
#  E-Commerce Platform — Backend & Docker Environment Template
#  Copy file này thành `.env` và thay đổi thông tin khi triển khai
# ═══════════════════════════════════════════════════════════════

# Spring Boot Active Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# MySQL 8.0 Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=product_db
MYSQL_ROOT_PASSWORD=CHANGE_ME_DEV_MYSQL_ROOT_PASSWORD
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=CHANGE_ME_DEV_MYSQL_PASSWORD

# Redis 7 Cache & Rate Limiter Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_DEV_REDIS_PASSWORD

# Apache Kafka & Kafka UI Configuration
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Eureka Discovery Server Configuration
EUREKA_USER=eureka
EUREKA_PASSWORD=CHANGE_ME_DEV_EUREKA_PASSWORD
EUREKA_PORT=8761

# JWT Authentication Secret (Minimum 256-bit key, use 512-bit/64 bytes in prod)
JWT_SECRET=CHANGE_ME_DEV_JWT_SECRET_MIN_32_CHARS_LONG

# Internal Service-to-Service Key (Shared by order-service & product-service)
INTERNAL_SERVICE_KEY=CHANGE_ME_DEV_INTERNAL_SERVICE_KEY_MIN_32_CHARS

# Default Admin Seed (Optional in dev; required on empty prod DB)
DEFAULT_ADMIN_EMAIL=admin@shopmart.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD

# Frontend & Nginx Reverse Proxy Ports
FRONTEND_PORT=5173
NGINX_PORT=80

# Google Gemini AI Shopping Assistant (Chatbot Service)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash