# ═══════════════════════════════════════════════════════════════
#  ShopMart E-Commerce Platform — Production Environment Template
#  Copy file này thành `.env` trên VPS trước khi chạy `docker compose -f docker-compose.prod.yml up -d`
#  LƯU Ý BẢO MẬT: Tuyệt đối không commit file `.env` chứa mật khẩu thật lên Git!
# ═══════════════════════════════════════════════════════════════

# 1. Spring Profile
SPRING_PROFILES_ACTIVE=prod

# 2. MySQL 8.0 Production Credentials (Tạo mật khẩu ngẫu nhiên >= 24 ký tự)
# Lệnh tạo chuỗi ngẫu nhiên trên Linux: `openssl rand -base64 24`
MYSQL_DATABASE=product_db
MYSQL_USER=ecommerce_prod_user
MYSQL_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_24_CHARS
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_ROOT_PASSWORD_MIN_24_CHARS

# 3. Redis 7 Password (Tạo chuỗi ngẫu nhiên >= 32 ký tự)
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# 4. JWT Secret Key (Yêu cầu Base64/Hex tối thiểu 512-bit / 64 bytes cho HS512)
# Lệnh sinh key an toàn trên Linux VPS: `openssl rand -base64 64`
JWT_SECRET=CHANGE_ME_TO_GENUINE_512_BIT_SECRET_BASE64_GENERATED_BY_OPENSSL

# 5. Eureka Discovery Credentials
EUREKA_USER=eureka_prod
EUREKA_PASSWORD=CHANGE_ME_TO_STRONG_EUREKA_PASSWORD

# 6. Admin User Default Seed (Tài khoản khởi tạo ban đầu)
DEFAULT_ADMIN_EMAIL=admin@shopmart.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_ADMIN_PASSWORD_2026@
